    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.95",
    "fast-check": "^4.10.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "unplugin-icons": "^24.0.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "smol-toml": ">=1.7.1"
  }

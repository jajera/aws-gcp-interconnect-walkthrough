{
  "name": "aws-gcp-interconnect-walkthrough",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=18.20.8"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run generate:og-image && astro build",
    "preview": "astro preview",
    "validate": "tsx scripts/validate-content.ts",
    "generate:og-image": "tsx scripts/generate-og-image.ts",
    "format": "prettier --write .",
    "lint": "markdownlint-cli2 \"src/**/*.mdx\"",
    "test": "vitest --run"
  },
  "dependencies": {
